# Bible Reading PWA Environment Configuration

# Public Supabase URL & Anon Key (Optional for cloud database mode)
VITE_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (Never expose in client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# YouVersion ESV Settings
VITE_YOUVERSION_VERSION_ID=59

# NotebookLM Destination URL
VITE_PUBLIC_NOTEBOOKLM_URL=https://notebooklm.google.com/
